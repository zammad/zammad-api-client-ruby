module ZammadAPI
  module QueryEncoder
    def self?.encode: (untyped params) -> String?
    def self?.decode: (String? query) -> untyped
    def self?.lead_path: (Hash[untyped, untyped] element, untyped previous) -> Array[untyped]?
    def self?.misread: (untyped element, untyped previous) -> Symbol?
    def self?.written?: (untyped value) -> bool
    def self?.hash_pairs: (String? prefix, Hash[untyped, untyped] hash, Array[untyped]? lead) -> Array[[ String, untyped ]]
    def self?.value_pairs: (String path, untyped value, ?Array[untyped]? lead) -> Array[[ String, untyped ]]
    def self?.array_pairs: (String path, Array[untyped] array) -> Array[[ String, untyped ]]
    def self?.sorted_keys: (Hash[untyped, untyped] hash) -> Array[untyped]
  end
end
