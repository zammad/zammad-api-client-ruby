module ZammadAPI
  class Test
    # Deliberately outside ZammadAPI::Error: it says the test is wrong, not
    # that Zammad refused anything.
    class UnstubbedRequestError < ::StandardError
    end

    class Request < ::Data
      attr_reader verb: Symbol
      attr_reader path: String
      attr_reader query: Hash[String, untyped]
      attr_reader body: untyped
      attr_reader headers: Hash[String, String]
      attr_reader on_behalf_of: String?

      def self.new: (**untyped) -> instance
    end

    attr_reader config: Config
    attr_reader client: Client

    @stubs: Hash[[Symbol, String], Array[Hash[Symbol, untyped]]]
    @requests: Array[Request]
    @monitor: Thread::Mutex

    def initialize: (**untyped options) -> void
    def stub: (Symbol method, String path, ?status: Integer, ?body: untyped, ?headers: Hash[untyped, untyped], ?query: Hash[untyped, untyped]?) -> self
    def requests: () -> Array[Request]
    def reset: () -> self
    def stubbed: () -> Array[String]
    def inspect: () -> String

    def answer: (
      Symbol method,
      String path,
      operation: String,
      ?query: Hash[untyped, untyped]?,
      ?body: untyped,
      ?headers: Hash[untyped, untyped]?,
      ?resource_class: Class?,
      ?on_behalf_of: String?
    ) -> Response

    private

    # private_constant in the source; RBS has no way to say so.
    EMPTY_PAGE: Hash[Symbol, untyped]

    def key: (Symbol method, String path) -> [Symbol, String]
    def stringify: (untyped value) -> untyped
    def take: (Symbol method, String path, Hash[String, untyped] params) -> Hash[Symbol, untyped]?
    def matches?: (Hash[String, untyped]? expected, Hash[String, untyped] params) -> bool
    def response_for: (Hash[Symbol, untyped] stub) -> Response
    def stubbed_endpoints: () -> Array[String]
    def unstubbed_message: (Request request) -> String

    class Transport
      include ::ZammadAPI::Transport::Verbs

      attr_reader test: Test
      attr_reader config: Config
      attr_reader on_behalf_of: String?

      def initialize: (Test test, ?on_behalf_of: String?, ?config: Config) -> void
      def with_on_behalf_of: (String? identifier) -> Test::Transport
      def with_config: (Config) -> Test::Transport

      def request: (Symbol method, String path, operation: String, ?query: Hash[Symbol, untyped]?, ?body: untyped, ?headers: Hash[untyped, untyped]?, ?resource_class: Class?) -> Response
    end
  end
end
