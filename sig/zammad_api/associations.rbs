module ZammadAPI
  module Associations
    # The readers are answered through method_missing, from the belongs_to
    # declarations in lib/zammad_api/resources. The ones this gem
    # declares are listed here so that callers get types and completion; every
    # name means the same target wherever it is declared, so the type of a
    # given reader is accurate. The class is wider than any one resource, so
    # a reader the record does not declare type-checks here and raises
    # NoMethodError at runtime.
    class Proxy
      @record: Resources::Base
      @cache: Hash[Symbol, untyped]

      def initialize: (Resources::Base record) -> void
      def inspect: () -> String
      def forget: () -> void
      def method_missing: (Symbol, *untyped) -> untyped
      def respond_to_missing?: (Symbol, ?bool) -> bool

      def created_by: () -> Resources::User?
      def updated_by: () -> Resources::User?
      def customer: () -> Resources::User?
      def owner: () -> Resources::User?
      def organization: () -> Resources::Organization?
      def group: () -> Resources::Group?
      def state: () -> Resources::TicketState?
      def priority: () -> Resources::TicketPriority?
      def ticket: () -> Resources::Ticket?

      private

      def associations: () -> Hash[Symbol, Hash[Symbol, untyped]]
      def target: (Symbol name, Hash[Symbol, untyped] spec) -> untyped
      def resolve: (String class_name) -> untyped
    end
  end
end
